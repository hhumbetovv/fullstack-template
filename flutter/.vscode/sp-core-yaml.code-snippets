{
    "Initial Presentation Pubspec": {
        "prefix": "initpresentation",
        "scope": "yaml",
        "body": [
            "name: ${TM_DIRECTORY/(.*[\\/])([^\\/]+)[\\/][^\\/]+/$2/}_presentation",
            "",
            "environment:",
            "\tsdk: 3.9.0",
            "resolution: workspace",
            "",
            "dependencies:",
            "\tflutter:",
            "\t\tsdk: flutter",
            "",
            "\t#! Modules",
            "\tprocessor: any",
            "\tcore_presentation: any",
            "\tcommon_shared: any",
            "\tcommon_presentation: any",
            "\tui_foundation: any",
            "\tui_components: any",
            "",
            "\t#! Navigation",
            "\tauto_route: ^10.1.0",
            "",
            "\t#! Dependency Injection",
            "\tinjectable: ^2.5.0",
            "\tget_it: ^8.0.3",
            "",
            "dev_dependencies:",
            "\t#! Generator",
            "\tbuild_runner: ^2.4.15",
            "",
            "\t#? Modules",
            "\tgen_data: any",
            "\tgen_view_kit: any",
            "",
            "\t#? Navigation",
            "\tauto_route_generator: ^10.1.0",
            "",
            "\t#? Dependency Injection",
            "\tinjectable_generator: ^2.7.0",
        ]
    },
    "Initial Presentation Build": {
        "prefix": "buildpresentation",
        "scope": "yaml",
        "body": [
            "targets:",
            "\t$$default:",
            "\t\tbuilders:",
            "\t\t\t#! Package Generators",
            "\t\t\tauto_route_generator:",
            "\t\t\t\tenabled: true",
            "\t\t\t\tgenerate_for:",
            "\t\t\t\t\tinclude:",
            "\t\t\t\t\t\t- '**/wrapper.dart'",
            "\t\t\t\t\t\t- '**/view.dart'",
            "\t\t\t\t\t\t- 'lib/router/router.dart'",
            "\t\t\t#! Project Generators",
            "\t\t\tgen_data|data:",
            "\t\t\t\tenabled: true",
            "\t\t\t\tgenerate_for:",
            "\t\t\t\t\tinclude: ['**/state.dart', '**/source/**']",
            "\t\t\tgen_view_kit|view:",
            "\t\t\t\tenabled: true",
            "\t\t\t\tgenerate_for:",
            "\t\t\t\t\tinclude: ['**/view.dart']",
            "\t\t\tgen_view_kit|provider:",
            "\t\t\t\tenabled: true",
            "\t\t\t\tgenerate_for:",
            "\t\t\t\t\tinclude: ['**/provider.dart']",
            "\t\t\tgen_view_kit|view_model:",
            "\t\t\t\tenabled: true",
            "\t\t\t\tgenerate_for:",
            "\t\t\t\t\tinclude: ['**/view_model.dart']",
            "\t\t\t\toptions:",
            "\t\t\t\t\tenable_cached_builds: true",
            "",
            "global_options:",
            "\tgen_view_kit|view:",
            "\t\truns_before:",
            "\t\t\t- gen_view_kit|view_model",
            "\tgen_view_kit|provider:",
            "\t\truns_before:",
            "\t\t\t- gen_view_kit|view_model",
        ]
    },
    "Initial Domain Pubspec": {
        "prefix": "initdomain",
        "scope": "yaml",
        "body": [
            "name: ${TM_DIRECTORY/(.*[\\/])([^\\/]+)[\\/][^\\/]+/$2/}_domain",
            "",
            "environment:",
            "\tsdk: 3.9.0",
            "resolution: workspace",
            "",
            "dependencies:",
            "\tflutter:",
            "\t\tsdk: flutter",
            "",
            "\t#! Modules",
            "\tcore_domain: any",
            "",
            "\t#! Dependency Injection",
            "\tinjectable: ^2.5.0",
            "\tget_it: ^8.0.3",
            "",
            "dev_dependencies:",
            "\t#! Generator",
            "\tbuild_runner: ^2.4.15",
            "",
            "\t#? Modules",
            "\tgen_exporter: any",
            "",
            "\t#? Dependency Injection",
            "\tinjectable_generator: ^2.7.0",
        ]
    },
    "Initial Domain Build": {
        "prefix": "builddomain",
        "scope": "yaml",
        "body": [
            "targets:",
            "\t$$default:",
            "\t\tbuilders:",
            "\t\t\t#! Project Generators",
            "\t\t\tgen_exporter|exporter:",
            "\t\t\t\tenabled: true",
            "\t\t\t\toptions:",
            "\t\t\t\t\tfolders:",
            "\t\t\t\t\t\t- entity",
            "\t\t\t\t\t\t- repository",
            "\t\t\t\t\t\t- usecase",
            "",
            "global_options:",
            "\tgen_exporter|exporter:",
            "\t\truns_before:",
            "\t\t\t- injectable_generator|injectable_builder",
        ]
    }
}