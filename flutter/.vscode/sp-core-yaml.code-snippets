{
  "Initial Presentation Pubspec": {
    "prefix": "initpresentation",
    "scope": "yaml",
    "body": [
      "name: ${TM_DIRECTORY/(.*[\\/])([^\\/]+)[\\/][^\\/]+/$2/}_presentation",
      "",
      "environment:",
      "\tsdk: ^3.10.1",
      "resolution: workspace",
      "",
      "dependencies:",
      "\tflutter:",
      "\t\tsdk: flutter",
      "",
      "\t#! Modules",
      "\tprocessor: any",
      "\tcore_presentation: any",
      "\tcore_navigation: any",
      "\tcommon_shared: any",
      "\tcommon_presentation: any",
      "\tui_foundation: any",
      "\tui_components: any",
      "",
      "\t#! Navigation",
      "\tauto_route: ^10.1.0",
      "",
      "\t#! Dependency Injection",
      "\tinjectable: ^2.5.2",
      "\tget_it: ^8.0.3",
      "",
      "dev_dependencies:",
      "\t#! Generator",
      "\tbuild_runner: ^2.4.15",
      "",
      "\t#? Modules",
      "\tgen_data: any",
      "\tgen_view_kit: any",
      "",
      "\t#? Dependency Injection",
      "\tinjectable_generator: ^2.7.0",
    ]
  },
  "Initial Presentation Build": {
    "prefix": "buildpresentation",
    "scope": "yaml",
    "body": [
      "targets:",
      "\t$$default:",
      "\t\tauto_apply_builders: false",
      "\t\tbuilders:",
      "\t\t\t#! Project Generators",
      "\t\t\tgen_data|data:",
      "\t\t\t\tenabled: true",
      "\t\t\t\tgenerate_for:",
      "\t\t\t\t\tinclude:",
      "\t\t\t\t\t\t- '**/state.dart'",
      "\t\t\t\t\t\t- '**/source/**'",
      "\t\t\tgen_view_kit|view:",
      "\t\t\t\tenabled: true",
      "\t\t\t\tgenerate_for:",
      "\t\t\t\t\tinclude:",
      "\t\t\t\t\t\t- '**/view.dart'",
      "\t\t\tgen_view_kit|provider:",
      "\t\t\t\tenabled: true",
      "\t\t\t\tgenerate_for:",
      "\t\t\t\t\tinclude:",
      "\t\t\t\t\t\t- '**/provider.dart'",
      "\t\t\tgen_view_kit|view_model:",
      "\t\t\t\tenabled: true",
      "\t\t\t\tgenerate_for:",
      "\t\t\t\t\tinclude:",
      "\t\t\t\t\t\t- '**/view_model.dart'",
      "\t\t\t\toptions:",
      "\t\t\t\t\tenable_cached_builds: true",
      "",
      "global_options:",
      "\tgen_view_kit|view:",
      "\t\truns_before:",
      "\t\t\t- gen_view_kit|view_model",
      "\tgen_view_kit|provider:",
      "\t\truns_before:",
      "\t\t\t- gen_view_kit|view_model",
    ]
  },
